APP_NAME=Local AI Agent
APP_ENV=dev
API_KEY=
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_REQUESTS_PER_MINUTE=120
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_TO_FILE=true
LOG_JSON=true
TELEMETRY_ENABLED=false

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b

ENABLE_MEMORY=false
MEMORY_BACKEND=noop
MEMORY_FILE_PATH=data/memory/interactions.jsonl
MEMORY_SQLITE_PATH=
MEMORY_RECALL_LIMIT=5
MEMORY_MAX_RECALL_LIMIT=20
MEMORY_TTL_DAYS=90

SESSION_MAX_SESSIONS=200
SESSION_MAX_MESSAGES=50
# Empty uses the OS app-data/state directory. Set an explicit path only for development.
STATE_DB_PATH=
TASK_WORKTREE_ROOT=
RUN_EVENT_POLL_INTERVAL_SECONDS=0.1

AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=120
APPROVAL_TTL_SECONDS=300
APPROVAL_MAX_PENDING=200

TOOL_WORKSPACE_ROOT=.
TOOL_ALLOWED_COMMANDS=git,python,pytest,uv,ruff
TOOL_COMMAND_TIMEOUT_SECONDS=30
TOOL_MAX_OUTPUT_CHARS=20000
TOOL_MAX_FILE_BYTES=200000
